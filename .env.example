# Copy this file to .env and fill in the values. Never commit .env.

PORT=3000

# SMTP account the website sends FROM.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (without spaces) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-char-app-password

# Inbox that receives the enquiries.
MAIL_TO=ictclubnps@gmail.com

# Set to 1 when running behind a reverse proxy / hosting platform (for correct rate limiting).
TRUST_PROXY=
